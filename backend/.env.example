# NetraNews backend config — copy this file to ".env.local" and fill in your values,
# then start the backend with ./run.sh (macOS/Linux/Git Bash) or run.cmd (Windows).
#
# .env.local is gitignored — keep real keys out of git.

# Groq API key for live AI (summary / translate / chat).
# Get a free key at https://console.groq.com/keys
# Leave empty to use built-in offline fallback text (the app still runs).
LLM_API_KEY=

# --- Optional overrides (defaults shown; uncomment to change) ---

# OpenAI-compatible base URL. Swap to use another provider:
#   OpenRouter: https://openrouter.ai/api/v1
#   Mistral:    https://api.mistral.ai/v1
#   Ollama:     http://localhost:11434/v1   (local, no key needed)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Model id (must match the chosen provider).
# LLM_MODEL=llama-3.3-70b-versatile

# MongoDB connection. Defaults to a local MongoDB; set an Atlas URI for the cloud cluster.
# MONGODB_URI=mongodb://localhost:27017/netradb

# Server port.
# PORT=8080

# --- Admin account (for the role-gated admin dashboard / news CRUD) ---
# Set both to auto-create (or promote an existing user) to role=ADMIN at startup.
# Leave blank to skip. Log in with these credentials to access the admin dashboard.
# ADMIN_EMAIL=admin@netranews.local
# ADMIN_PASSWORD=change-me-please
